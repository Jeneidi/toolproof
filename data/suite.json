      ],
      "expected": {
        "behavior": "sequence",
        "calls": [
          { "name": "search_flights", "arguments": { "origin": "AMM", "destination": "CDG", "depart_date": "2026-09-14", "passengers": 1 } },
          { "name": "book_flight", "arguments": { "flight_id": "flt_7ab1", "passenger_name": "Lina Haddad" }, "depends_on": 0 }
        ]
