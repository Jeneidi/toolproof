{
  "version": "1.0.0",
  "normalization": {
    "strings": "Trim, collapse internal whitespace, and compare case-insensitively.",
    "dates": "If the expected schema field is a YYYY-MM-DD date, parse an equivalent natural-language date before comparing.",
    "numbers": "Compare with an absolute tolerance of 0.000001.",
    "arrays": "Compare in order after applying scalar normalization."
  },
  "cases": [
    {
      "id": "should-call-01",
      "category": "should-call",
      "prompt": "What will the weather be in Amman on March 4, 2026? Use Celsius.",
      "tools": ["get_weather", "get_weather_alerts"],
      "expected": {
        "behavior": "call",
        "calls": [{ "name": "get_weather", "arguments": { "location": "Amman", "date": "2026-03-04", "unit": "celsius" } }]
      }
    },
    {
